// titanic.rc -- the STRINGTABLE and RAW resources of TI.EXE.
//
// STRINGTABLE extracted from the original TI.EXE via LoadStringA (ground truth).
// The RAW blocks are res/raw/*.bin; the icons, menu, dialogs and accelerators
// are res/typed/ (appended by res/append_typed_res.py).

STRINGTABLE
BEGIN
    0, "Titanic"
